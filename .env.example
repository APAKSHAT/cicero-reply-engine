# One of these. If OPENROUTER_API_KEY is set it wins.
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-v1-...

# Drafting is the stage worth spending on -- it is the only one whose output a
# human reads. Point it at the best model you have credit for:
# CICERO_MODEL_GENERATE=anthropic/claude-sonnet-4.5

# Optional. Per-stage model override. Classification and verification are
# schema-constrained and high-volume; at real throughput these are the two to
# move down a tier first.
# CICERO_MODEL_CLASSIFY=claude-opus-5
# CICERO_MODEL_GENERATE=claude-opus-5
# CICERO_MODEL_VERIFY=claude-opus-5

# Optional. Forces dry_run on regardless of config/policy.yaml. It can only
# force it ON -- there is no env var that turns sending on.
# CICERO_DRY_RUN=1

# Only for the real Gmail/Calendar adapters.
# GOOGLE_CREDENTIALS_PATH=credentials.json
